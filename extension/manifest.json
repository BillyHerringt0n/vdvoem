{
  "manifest_version": 3,
  "name": "Вдвоём — Кинопоиск",
  "version": "1.0.0",
  "description": "Совместный просмотр Кинопоиска в комнате «Вдвоём»: общая пауза, перемотка, переключение серий и чат поверх фильма.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://hd.kinopoisk.ru/*", "https://*.yandex.ru/*", "https://*.yandex.net/*"],
      "js": ["kp.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.github.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
